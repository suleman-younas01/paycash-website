{% extends 'public/layout.twig' %}
{% block content %}
    {{ include('public/includes/styles.twig') }}
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/notie/dist/notie.min.css">


    <div class="container-fluid">
        <div class="logo mb-5">
            <img src="{{ env.APP_URL }}uploads/settings/{{ siteLogo }}" alt="PayCash Logo" class=" w-75">
        </div>
      <div class="text-center mt-5">
          <div class="text-gray-300 fw-bold fs-5">Enter your OTP to Recover Password for login</div>
          <div class="text-center mt-3 mb-3">
              <span class="fs-17" style="color: #000000;">Remember Password?<a href="/login" class="text-decoration-none fw-bold text-danger" style="color: #000000;"> LogIn</a></span>
          </div>
      </div>
        <div id="ErrorMessage"></div>
        <form id="loginForm" >
            <div class="mb-3">
                <input type="text" class="form-control" id="code" placeholder="OTP" required>
                <input type="hidden" id="email"  class="form-control "  value="{{ Reset }}" >
                <small  class="form-text text-danger" style="color:red;">  Please check your email (spam folder) ({{ Reset }}) for the confirmation code.</small>
            </div>
            <div class="mb-3">
                <input type="password" class="form-control"  id="password"  name="password" placeholder="New Password" required>
            </div>
            <div class="mb-3">
                <input type="password" class="form-control"  id="confirm_password" name="confirm_password" placeholder="Confirm Password" required>
            </div>
            <div id="ErrorMessage"></div>
            <button type="button" id="btn" class=" email-login-btn"  onclick="resetPassword()">Change password</button>
        </form>

    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/notie/4.3.1/notie.min.js" integrity="sha512-NHRCwRf2LnVSlLDejCA9oS3fG3/FLSQIPCjAWl3M7tVi5wszwr6FxkjotWnQDXLE+aLKcxRrzFDNEgXj9nvkPw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        function resetPassword()
        {
            var password=$("#password").val();
            var code=$("#code").val();
            var email=$("#email").val();
            var confirmPassword=$("#confirm_password").val();
            var csrf_token=$("input[name=csrf]").val();
            $("#ErrorMessage").html('');
            if(code!="" && password!='' && confirmPassword !=''&& email !='') {
                if(password == confirmPassword){
                    document.getElementById("btn").innerHTML = "Loading";
                    $.ajax
                    ({
                        type: 'post',
                        url: '/reset/login',
                        data: {
                            email: email,
                            password: password,
                            code: code,
                            csrf: csrf_token,
                        },
                        success: function (response) {

                            response=$.parseJSON(response);
                            console.log(response);
                            if(response['statusCode']=="200"){
                                document.getElementById("btn").disabled = true;
                                document.getElementById("btn").innerHTML = "Change Password";
                                notie.alert({type: 'error', text: response['message'], time: 5});

                                setTimeout(() => {
                                    window.location.href="/login";
                                }, "1000")

                            } else if (response['statusCode']=="202") {
                                document.getElementById("btn").innerHTML = "Change Password";
                                notie.alert({type: 'error', text: response['message'], time: 5});

                            } else {
                                document.getElementById("btn").innerHTML = "Change Password";
                               notie.alert({type: 'error', text: 'Missing Required Input!', time: 5});

                            }
                        }
                    });
                } else{
                    notie.alert({type: 'error', text: 'Password Not Matched!', time: 5});
                }
            } else{
                notie.alert({type: 'error', text: 'Missing Required Input!', time: 5});
            }
            return false;
        }
    </script>
{% endblock %}