{% extends 'public/layout.twig' %}
{% block content %}
    {{ include('public/includes/styles.twig') }}
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/notie/dist/notie.min.css">
    <div class="container-fluid">
        <div class="logo mb-5">
            <img src="{{ env.APP_URL }}uploads/settings/{{ siteLogo }}" alt="PayCash Logo" class=" w-75">
        </div>
        <h1 class="mt-5 fw-bold fs-30" style="color: #000000;">Account Verification</h1>
        <p class="login-text mb-2" style="font-size: 14px">Enter your OTP to verify your account</p>
        <div id="ErrorMessage"></div>
        <form id="registerForm">
            <div class="mb-2 d-flex">
                <input type="text" class="form-control me-1" id="verify_code" name="verify_code" placeholder="Enter your otp" required>
             </div>
            <div class="mb-3 d-flex">
                <input type="hidden" id="email"  class="form-control"  value="{{ AccountVerify }}" >
                <input type="hidden" id="csrf"  class="form-control"  value="{{ csrf }}" >
                <small  class="form-text text-danger" style="color:red;">  Please check your email (spam folder) ({{ AccountVerify }}) for the Verification code.</small>
            </div>
            <button id="btn" type="button" onclick="verify()" class=" email-login-btn">Verify</button>
        </form>
        <div class="text-center mt-3 mb-3">
            <span class="fs-17" style="color: #000000;">Already have an account?<a href="#" onclick="app_route(event, '/login')" class="text-decoration-none fw-bold" style="color: #000000;"> Signin</a></span>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/notie/4.3.1/notie.min.js" integrity="sha512-NHRCwRf2LnVSlLDejCA9oS3fG3/FLSQIPCjAWl3M7tVi5wszwr6FxkjotWnQDXLE+aLKcxRrzFDNEgXj9nvkPw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        function verify()
        {
            var verify_code=$("#verify_code").val();
            var email=$("#email").val();
            var csrf_token=$("input[name=csrf]").val();
            $("#ErrorMessage").html('');
            if(verify_code!="" && email !='') {
                document.getElementById("btn").innerHTML = "Loading";
                $.ajax
                ({
                    type: 'post',
                    url: '/email-verification',
                    data: {
                        email: email,
                        verify_code: verify_code,
                        csrf: csrf_token,
                    },
                    success: function (response) {
                        console.log(response);
                        if(response =="1"){
                            notie.alert({type: 'success', text: 'Congratulations! Your Account is Verified', time: 5});
                            document.getElementById("btn").disabled = true;
                            document.getElementById("btn").innerHTML = "Verify";
                            setTimeout(() => {
                                window.location.href="/login";
                            }, 1000)

                        } else if (response=="2") {
                            document.getElementById("btn").innerHTML = "Verify";
                            notie.alert({type: 'error', text: 'Enter your OTP', time: 5});
                        } else if (response=="3") {
                            document.getElementById("btn").innerHTML = "Verify";
                            notie.alert({type: 'error', text: 'Invalid OTP Code', time: 5});

                        } else {
                            document.getElementById("btn").innerHTML = "Verify";
                            notie.alert({type: 'error', text: 'Missing Required Input!', time: 5});

                        }
                    }
                });

            } else{
                notie.alert({type: 'error', text: 'Missing Required Input!', time: 5});
            }
            return false;
        }
    </script>
{% endblock %}