{% extends 'public/layout.twig' %}
{% block content %}

    {{ include('public/includes/bottomNav.twig') }}

    <!-- FAQ Page -->
    <div style="position: relative">
        <div class="d-flex align-items-center pt-4 pb-1 fixed-top" style="background-color: #e0e0e0;">
            <a href="/setting">
                <p class="fw-bold" style="color: #0e7bb2">
                    <i class="bi bi-chevron-left"></i> Account
                </p>
            </a>
        </div>
        <div class="container" style="margin-top:6rem!important; margin-bottom:7rem!important;">
            <div class="accordion" id="accordionExample">
                {% for faq in faqs %}
                    <div class="accordion-item my-2">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed bg-warning" type="button" data-bs-toggle="collapse" data-bs-target="#collapse{{ loop.index }}" aria-expanded="false" aria-controls="collapse{{ loop.index }}">
                                {{ faq.question | raw }}
                            </button>
                        </h2>
                        <div id="collapse{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#accordionExample">
                            <div class="accordion-body">
                                {{ faq.answer | raw }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

    </div>
{% endblock %}