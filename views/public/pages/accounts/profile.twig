{% extends 'public/layout.twig' %}
{% block content %}

    {{ include('public/includes/bottomNav.twig') }}

    <div style=" margin-bottom:7rem!important; position: relative;" >
        <div class="d-flex align-items-center pt-4 pb-1 fixed-top" style="background-color: #e0e0e0;">
            <a href="/setting">
                <p class="fw-bold" style="color: #0e7bb2">
                    <i class="bi bi-chevron-left"></i> Account
                </p>
            </a>
        </div>
        <div class="container" style="margin-top: 9rem!important;">
            <div class="d-flex justify-content-center mb-4">
                <img src="{{ env.APP_URL }}uploads/profile/{{ UserInfo[0].profile_img }}" alt="Profile" class="" style="background-color: #0e7bb2; border-radius: 15px!important;" width="40%">
{#                <i class="bi bi-pencil-square fs-4"></i>#}
            </div>
            <div class="table-responsive">
                <table class="table">
                    <tbody>
                    <tr>
                        <td>Name:</td>
                        <td>{{ UserInfo[0].fname }} {{ UserInfo[0].lname }}</td>
                    </tr>
                    <tr>
                        <td>Email Address:</td>
                        <td>{{ UserInfo[0].email }}</td>
                    </tr>
                    <tr>
                        <td>Mobile Number:</td>
                        <td>{{ UserInfo[0].phone_no }}</td>
                    </tr>
                    <tr>
                        <td>Address:</td>
                        <td>{{ UserInfo[0].address }}</td>
                    </tr>

                    </tbody>
                </table>
            </div>

        </div>
    </div>
{% endblock %}