{% extends 'public/layout.twig' %}
{% block content %}
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/notie/dist/notie.min.css">

    {{ include('public/includes/bottomNav.twig') }}

    <!-- Change Password Page -->
    <div style="margin: 5rem 0 7rem 0 !important; position: relative;">
        <div class="d-flex align-items-center pt-4 pb-1 fixed-top" style="background-color: #e0e0e0; z-index:1;">
            <a href="/setting">
                <p class="fw-bold" style="color: #0e7bb2">
                    <i class="bi bi-chevron-left"></i> Account
                </p>
            </a>
        </div>
        <div class="container">
            <h4 class="fw-bold">Recover Your Password</h4>
            <form id="change_password" method="post">
                <div class="mb-3">
                    <input type="password" class="form-control" name="currentPassword" id="currentPassword" placeholder="Enter current password" required>
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" name="newPassword" id="newPassword" placeholder="Enter new password" required>
                    <input type="hidden" class="form-control" name="id" id="idForPassword" placeholder="Enter new password" value="{{ loginId }}" required>
                </div>
                <div class="mb-3">
                    <input type="password" class="form-control" name="newconfirmPassword" id="confirmPassword" placeholder="Re-enter new password" required>
                </div>
                <div class="text-center ">
                    <button type="button" class="btn deposit-button w-75 text-color" onclick="change_password()" id="btn-password">Change Password</button>
                </div>
            </form>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/notie/4.3.1/notie.min.js" integrity="sha512-NHRCwRf2LnVSlLDejCA9oS3fG3/FLSQIPCjAWl3M7tVi5wszwr6FxkjotWnQDXLE+aLKcxRrzFDNEgXj9nvkPw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        function change_password() {
            var currentPassword = document.getElementById("currentPassword").value;
            var newPassword = document.getElementById("newPassword").value;
            var confirmPassword = document.getElementById("confirmPassword").value;

            if (!currentPassword || !newPassword || !confirmPassword) {
                notie.alert({type: 'error', text: 'Required fields are empty!'});
                return;
            }

            if (newPassword !== confirmPassword) {
                notie.alert({type: 'error', text: 'New password and confirm password do not match!'});
                return;
            }

            var form_Data = new FormData(document.getElementById("change_password"));

            $.ajax({
                url: "/changePassword/post",
                type: "POST",
                data: form_Data,
                contentType: false,
                cache: false,
                processData: false,
                success: function (dataResult) {
                    console.log(dataResult);
                    if (dataResult == 1) {
                        notie.alert({type: 'success', text: 'Passwords updated successfully'});
                        $('#change_password')[0].reset();
                    } else if (dataResult == 2) {
                        notie.alert({type: 'error', text: 'Your current password is wrong!'});
                    } else if (dataResult == 3) {
                        notie.alert({type: 'error', text: 'Required fields are empty!'});
                    } else {
                        notie.alert({type: 'error', text: 'Something went wrong.'});
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error:", status, error);
                    notie.alert({type: 'error', text: 'An error occurred while processing your request.'});
                }
            });

        }


    </script>
{% endblock %}