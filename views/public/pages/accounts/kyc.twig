<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- JavaScript -->
<script>
    // Function to toggle the visibility of KYC tabs
    function showKycTab(tabId) {
        // Hide all KYC tabs
        document.querySelectorAll('.kyc-content').forEach((tab) => {
            tab.classList.add('d-none');
        });

        // Remove active class from all KYC tab buttons
        document.querySelectorAll('.kyc-nav-btn').forEach((btn) => {
            btn.classList.remove('active');
        });

        // Show the selected tab
        const tabToShow = document.getElementById(tabId);
        if (tabToShow) {
            tabToShow.classList.remove('d-none');
        }

        // Add active class to the clicked button
        const activeBtn = document.querySelector(`.kyc-nav-btn[data-target="${tabId}"]`);
        if (activeBtn) {
            activeBtn.classList.add('active');
        }
    }

    // Add event listeners to KYC tab buttons
    document.querySelectorAll('.kyc-nav-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const targetTab = btn.getAttribute('data-target');
            showKycTab(targetTab);
        });
    });
</script>


