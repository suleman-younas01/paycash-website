                </div>

            </div>
        </div>
    </div>
    <script>

        // Function to toggle the visibility of home content sections (home navbar)
        function showHomeSection(sectionId) {
            // Hide all home content sections
            document.querySelectorAll('.home-content').forEach((section) => {
                section.classList.add('d-none');
            });

            // Remove active class from all home navbar buttons
            document.querySelectorAll('.home-nav-btn').forEach((btn) => {
                btn.classList.remove('active');
            });

            // Show the selected section
            const sectionToShow = document.getElementById(sectionId);
            if (sectionToShow) {
                sectionToShow.classList.remove('d-none');
            }

            // Add active class to the clicked button
            const activeBtn = document.querySelector(`.home-nav-btn[data-target="${sectionId}"]`);
            if (activeBtn) {
                activeBtn.classList.add('active');
            }
        }
        // Add event listeners to home navbar buttons
        document.querySelectorAll('.home-nav-btn').forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const targetSection = btn.getAttribute('data-target');
                showHomeSection(targetSection);
            });
        });

    </script>
    <script>
        // Function to handle animation and visibility toggling
        function showHomeSection(sectionId) {
            const allSections = document.querySelectorAll('.home-content');
            const currentSection = document.querySelector('.home-content.active');
            const newSection = document.getElementById(sectionId);

            // Exit the current section if exists
            if (currentSection) {
                currentSection.classList.remove('active');
                currentSection.classList.add('exit');

                // Wait for the exit animation to complete before hiding the element
                setTimeout(() => {
                    currentSection.classList.add('d-none');
                    currentSection.classList.remove('exit');
                }, 400); // Matches the CSS transition duration
            }

            // Activate the new section
            if (newSection) {
                newSection.classList.remove('d-none');
                newSection.classList.add('active');
            }

            // Update the active button
            document.querySelectorAll('.home-nav-btn').forEach((btn) => {
                btn.classList.remove('active');
            });

            const activeBtn = document.querySelector(`.home-nav-btn[data-target="${sectionId}"]`);
            if (activeBtn) {
                activeBtn.classList.add('active');
            }
        }

        // Attach event listeners to navigation buttons
        document.querySelectorAll('.home-nav-btn').forEach((btn) => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                const targetSection = btn.getAttribute('data-target');
                showHomeSection(targetSection);
            });
        });
    </script>


{% endblock %}