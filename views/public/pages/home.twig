            opacity: 0;
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1;
        }

        .home-content.active {
            transform: translateX(0);
            opacity: 1;
            z-index: 2;
            position: relative;
        }

        .home-content.exit {
