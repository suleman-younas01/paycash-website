{% extends 'public/layout.twig' %}
{% block content %}

    {{ include('public/includes/bottomNav.twig') }}

    <!-- Account-content -->
    <div id="account-content" class=" zoom-in"  style="margin: 0rem 0 7rem 0 !important; position: relative;">
        <div class="d-flex bg-dark pt-4 pb-3 justify-content-between align-items-center fixed-top">
            <div class="flex-grow-1 text-center">
                <span class="navbar-brand mb-0 h4 fw-bold">Settings</span>
            </div>
            <i class="bi bi-bell me-3"></i>
        </div>
        <div class="card border-0 p-2 my-3" style="margin-top: 6rem!important;">
            <a href="/profile">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">My Profile</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="card border-0 p-2 my-3" >
            <a href="/bankDetails">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">Bank Details</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="card border-0 p-2 my-3" >
            <a href="/changePassword">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">Change Password</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="card border-0 p-2 my-3" >
            <a href="/faq">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">FAQ</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>

            </a>
        </div>
        <div class="card border-0 p-2 my-3" >
            <a href="/kyc">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">My KYC</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="card border-0 p-2 my-3">
            <a href="/termsCondition">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">Terms & Conditions</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="card border-0 p-2 my-3">
            <a href="/privacy">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">Privacy Policy</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>
            </a>

        </div>
        <div class="card border-0 p-2 my-3">
            <a href="/about">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">About Us</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>
            </a>

        </div>
        <div class="card border-0 p-2 my-3">
            <a href="/appVersion">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="fw-bold text-dark">App Version</div>
                    <div>
                        <i class="fa-solid fa-share account-icon me-3" ></i>
                    </div>
                </div>
            </a>
        </div>
        <div class="text-center mt-5">
                        <a href="/logout">
                            <button class="btn deposit-button w-50 text-color">LogOut</button>
                        </a>

                    </div>
    </div>

{% endblock %}



