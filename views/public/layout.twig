<!doctype html>
<html lang="en">
<head>
    <title>{{ seo.title }}</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" href="https://fonts.gstatic.com/s/poppins/v15/pxiByp8kv8JHgFVrLGT9Z1xlEA.ttf" as="font" type="font/ttf" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="{{ env.APP_URL }}assets/public/img/favicon.png">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf/notyf.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    {{ include('public/includes/dashboardStyle.twig') }}
    <style>
        .hide{
            display: none !important;
        }
        /* Loading Dots Animation */
        .dot {
            display: inline-block;
            animation: blink 1.5s infinite;
        }

        .dot:nth-child(2) { animation-delay: 0.3s; }
        .dot:nth-child(3) { animation-delay: 0.6s; }

        @keyframes blink {
            0% { opacity: 0; }
            50% { opacity: 1; }
            100% { opacity: 0; }
        }

    </style>
</head>
<body>
<!-- Page Loader -->
<!-- Header Section -->
<div class="header-section">
    <div class="circle large"></div>
    <div class="circle large2"></div>
    <div class="circle large3"></div>
    <div class="circle small"></div>
    <div class="circle small1"></div>
    <div class="circle small2"></div>
    <div class="circle small3"></div>
</div>
<!-- /.Page Loader -->
{#{{ include('public/includes/navbar.twig') }}#}

{% block content %} {% endblock %}
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/notyf/notyf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/notify.js/2.0.0/notify.min.js" integrity="sha512-iy8/ErLJUuqWbu30yUSCxXtE3FCDZi3y5op0Duqdp7vtpeh1E6ZyAPnRS+OrJHddh4uP30oYpwNt7TXPbmP5lQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
{#{{ include('public/includes/footer.twig') }}#}

<script>
    const notyf = new Notyf({
        duration: 4000,
        position: { x: 'right', y: 'top' },
        dismissible: true,
        ripple: true,
        types: [
            {
                type: 'info',
                background: '#2196f3',
                icon: {
                    className: 'fas fa-info-circle',
                    tagName: 'i',
                    color: '#fff',
                },
            },
            {
                type: 'warning',
                background: '#ff9800',
                icon: {
                    className: 'fas fa-exclamation-triangle',
                    tagName: 'i',
                    color: '#fff',
                },
            },
            {
                type: 'success',
                background: '#4caf50',
                icon: {
                    className: 'fas fa-check-circle',
                    tagName: 'i',
                    color: '#fff',
                },
            },
            {
                type: 'error',
                background: '#f44336',
                icon: {
                    className: 'fas fa-times-circle',
                    tagName: 'i',
                    color: '#fff',
                },
            },
        ],
    });

</script>
