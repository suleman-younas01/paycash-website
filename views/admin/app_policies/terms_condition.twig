{% extends 'admin/master.twig' %}
{% block content %}
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">

    <!-- Bootstrap CDN (for layout and styles) -->
    <style>
        div#cke_notifications_area_des {
            display: none  !important;
        }
        div#cke_notifications_area_edit_des{
            display: none  !important;
        }
        div#cke_notifications_area_des2 {
            display: none  !important;
        }
        div#cke_notifications_area_comment {
            display: none !important;
        }
        .cke_notifications_area{
            display: none !important;
        }

    </style>
    <div id="content" class="main-content">
        <div class="toolbar" id="kt_toolbar">
            <div id="kt_toolbar_container" class="container-fluid d-flex flex-stack">
                <!--begin::Page title-->
                <div data-kt-swapper="true" data-kt-swapper-mode="prepend" data-kt-swapper-parent="{default: '#kt_content_container', 'lg': '#kt_toolbar_container'}" class="page-title d-flex align-items-center flex-wrap me-3 mb-5 mb-lg-0">
                    <!--begin::Title-->
                    <h1 class="d-flex text-dark fw-bolder fs-3 align-items-center my-1">Basic Info</h1>
                    <!--end::Title-->
                    <!--begin::Separator-->
                    <span class="h-20px border-gray-300 border-start mx-4"></span>
                    <!--end::Separator-->
                    <!--begin::Breadcrumb-->
                    <ul class="breadcrumb breadcrumb-separatorless fw-bold fs-7 my-1">
                        <!--begin::Item-->
                        <li class="breadcrumb-item text-muted">Policies</li>
                        <!--end::Item-->
                        <!--begin::Item-->
                        <li class="breadcrumb-item">
                            <span class="bullet bg-gray-300 w-5px h-2px"></span>
                        </li>
                        <!--end::Item-->
                        <!--begin::Item-->
                        <li class="breadcrumb-item text-muted">Terms& Conditions</li>

                    </ul>
                    <!--end::Breadcrumb-->
                </div>
                <!--end::Page title-->
            </div>
        </div>

        <div class="layout-px-spacing pt-9">
            <div class="middle-content container-xxl p-0">
                <div class="account-settings-container layout-top-spacing">
                    <div class="content-body">
                        <div class="container-fluid">
                            <!-- row -->
                            <div class="row">

                                <div class="col-xl-12 col-lg-12">
                                    <div class="card  card-bx m-b30">
                                        <div class="card-header pt-9">
                                            <h6 class="title">Terms& Conditions</h6>
                                        </div>
                                        <form method="post" class="profile-form" id="termsCondition">
                                            <div class="card-body">

                                                <div class="row ">
                                                    <div class="col-md-12 fv-row">
                                                        <label class="fs-6 fw-bold mb-2"> Content</label>
                                                        <textarea class="form-control form-control-solid" rows="3" name="content" id="terms_content"
                                                                  placeholder="Type Course Details">{{ terms.content }}</textarea>
                                                    </div>
                                                    <input type="hidden" name="csrf" value="{{ csrf }}">
                                                </div>
                                            </div>
                                            <div class="card-footer">
                                                <button type="button" class="btn btn-secondary" id="btn-terms" onclick="do_terms()">UPDATE</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- CKEditor CDN -->

    <script src="https://cdn.ckeditor.com/4.19.0/standard/ckeditor.js"></script>
    <script>

        CKEDITOR.replace('terms_content', {
            filebrowserUploadMethod: 'form'
        });
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- CKEditor CDN -->
    <script>
        function do_terms() {
            for (instance in CKEDITOR.instances) {
                CKEDITOR.instances[instance].updateElement();
            }
            var form_Data = new FormData(document.getElementById("termsCondition"));

            $.ajax({
                url: "/admin/terms&condition",
                type: "POST",
                data: form_Data,
                contentType: false,
                cache: false,
                processData: false,
                success: function (dataResult) {


                    if (dataResult == 1) {
                        toastr.success('Updated Successfully.');

                    } else if (dataResult == 3) {
                        $('#error').html('<div class="alert-danger alert alert-fill  alert-dismissible alert-icon" role="alert"> Required fields are empty! <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></div>');

                    } else {
                        $('#error').html('<div class="alert-danger alert alert-fill  alert-dismissible alert-icon" role="alert">Somthing Went Wrong.<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="btn-close"></div>');

                    }

                }
            });
        }
    </script>
{% endblock %}